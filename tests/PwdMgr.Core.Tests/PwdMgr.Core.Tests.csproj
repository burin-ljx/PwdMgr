<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PwdMgr.Core.Tests</RootNamespace>
    <AssemblyName>PwdMgr.Core.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 采用 Microsoft.Testing.Platform 运行模型，测试直接跑在自身进程内。 -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- 测试方法名用下划线表达“场景_预期”；测试本身是毫秒级本地操作，不需要逐调用传取消令牌。 -->
    <NoWarn>$(NoWarn);CA1707;CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PwdMgr.Core\PwdMgr.Core.csproj" />
  </ItemGroup>

</Project>
