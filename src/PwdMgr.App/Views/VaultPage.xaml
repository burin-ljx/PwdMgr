<Page
    x:Class="PwdMgr.App.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PwdMgr.Core.Models"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewItemAccelerator" />
        <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnGeneratorAccelerator" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnLockAccelerator" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Padding="28,20,28,18" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock x:Name="VaultNameText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="VaultMetaText" Style="{StaticResource HintTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnLockClick" MinWidth="88" ToolTipService.ToolTip="锁定后需要重新选择钥匙文件">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" />
                    <TextBlock Text="上锁" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="SearchBox"
                PlaceholderText="搜索标题、用户名、网址、备注"
                Height="34"
                Width="380"
                HorizontalAlignment="Left"
                TextChanged="OnSearchChanged" />
            <Button
                x:Name="NewItemButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="NewItemButton"
                Content="新建条目"
                Click="OnNewItemClick" />
            <Button
                x:Name="GeneratorButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="GeneratorButton"
                Content="生成器"
                Click="OnGeneratorClick" />
            <Button Grid.Column="3" Content="回收站" Click="OnTrashClick" />
            <Button
                Grid.Column="4"
                Width="34"
                Height="32"
                Padding="0"
                Click="OnClearClipboardClick"
                ToolTipService.ToolTip="清空剪贴板">
                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
            </Button>
            <Button
                x:Name="MoreButton"
                Grid.Column="5"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="MoreButton"
                ToolTipService.ToolTip="更多">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="创建备份…" Click="OnBackupClick" />
                        <MenuFlyoutItem Text="检查密码库" Click="OnVerifyClick" />
                        <MenuFlyoutItem Text="从备份恢复…" Click="OnRestoreClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 列表 + 详情 -->
        <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="16">

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                    <ListView
                        x:Name="ItemList"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PasswordItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="4,4">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Username}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="删除"
                                        Style="{StaticResource DestructiveButtonStyle}"
                                        Padding="10,3"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Click="OnDeleteItemClick"
                                        ToolTipService.ToolTip="删除后可在回收站恢复" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyListPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="26"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="还没有条目"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="点击上方“新建条目”添加第一个"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- 详情：字段直接可编辑，改动后底部出现保存操作 -->
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                                <InfoBar
                                    x:Name="SaveErrorBar"
                                    Severity="Error"
                                    IsOpen="False"
                                    IsClosable="True" />

                                <InfoBar
                                    x:Name="TransientBar"
                                    Severity="Success"
                                    IsOpen="False"
                                    IsClosable="True" />

                                <TextBox
                                    x:Name="EditTitle"
                                    AutomationProperties.AutomationId="TitleBox"
                                    PlaceholderText="标题（必填）"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextChanged="OnFieldChanged" />

                                <TextBlock x:Name="DetailCreated" Style="{StaticResource HintTextStyle}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="用户名" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox
                                            x:Name="EditUsername"
                                            AutomationProperties.AutomationId="UsernameBox"
                                            TextChanged="OnFieldChanged" />
                                        <Button
                                            Grid.Column="1"
                                            Width="34"
                                            Height="30"
                                            Padding="0"
                                            Click="OnCopyUsernameClick"
                                            ToolTipService.ToolTip="复制用户名">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <PasswordBox
                                            x:Name="EditPassword"
                                            AutomationProperties.AutomationId="PasswordBox"
                                            PasswordChanged="OnPasswordChanged" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="DiceButton"
                                            Width="34"
                                            Height="30"
                                            Padding="0"
                                            Click="OnDiceClick"
                                            ToolTipService.ToolTip="生成密码">
                                            <TextBlock Text="🎲" FontSize="15" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="CopyPasswordButton"
                                            Width="34"
                                            Height="30"
                                            Padding="0"
                                            Click="OnCopyPasswordClick"
                                            ToolTipService.ToolTip="复制密码">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <ToggleButton
                                            x:Name="RevealButton"
                                            Grid.Column="3"
                                            Width="34"
                                            Height="30"
                                            Padding="0"
                                            Click="OnToggleRevealClick"
                                            ToolTipService.ToolTip="显示 / 隐藏密码">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="网址" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditUrl"
                                        AutomationProperties.AutomationId="UrlBox"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="标签" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditTags"
                                        AutomationProperties.AutomationId="TagsBox"
                                        PlaceholderText="用逗号分隔，例如：工作, 开发"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditNotes"
                                        AutomationProperties.AutomationId="NotesBox"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="72"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border
                            x:Name="ActionBar"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="0,12,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel
                                    x:Name="SaveActions"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <Button
                                        x:Name="SaveButton"
                                        AutomationProperties.AutomationId="SaveButton"
                                        Content="保存修改"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnSaveClick" />
                                    <Button Content="放弃修改" Click="OnRevertClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel
                        x:Name="NoSelectionPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="从左侧选择一个条目"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource HintTextStyle}" />
    </Grid>
</Page>
