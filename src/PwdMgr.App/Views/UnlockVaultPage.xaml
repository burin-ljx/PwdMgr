<Page
    x:Class="PwdMgr.App.Views.UnlockVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- 面板必须有不透明/透明的 Background 才参与命中测试，否则只有子控件能接收拖放。 -->
    <Grid x:Name="DropSurface" AllowDrop="True" Background="Transparent">
        <ScrollViewer Padding="32,28,32,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="760" HorizontalAlignment="Center" Spacing="18">

            <StackPanel Spacing="6">
                <TextBlock Text="打开密码库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="同时指定密码库文件与它对应的钥匙文件，可以直接输入或粘贴路径。两者必须来自同一次创建。" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                IsClosable="True" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="22">

                    <StackPanel Spacing="8">
                        <TextBlock Text="密码库文件" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox
                                x:Name="VaultPathBox"
                                AutomationProperties.AutomationId="VaultPathBox"
                                Text="{x:Bind ViewModel.VaultPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入或粘贴路径，例如 D:\我的密码库.pwdb" />
                            <Button Grid.Column="1" Content="选择…" Click="OnPickVaultClick" MinWidth="88" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="钥匙文件" Style="{StaticResource FieldLabelStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox
                                x:Name="KeyPathBox"
                                AutomationProperties.AutomationId="KeyPathBox"
                                Text="{x:Bind ViewModel.KeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="输入或粘贴路径，例如 D:\我的密码库.key" />
                            <Button Grid.Column="1" Content="选择…" Click="OnPickKeyClick" MinWidth="88" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <ProgressRing
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Content="返回" Click="OnBackClick" MinWidth="88" />
                    <Button
                        Content="打开"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="104"
                        IsEnabled="{x:Bind ViewModel.CanOpen, Mode=OneWay}"
                        Click="OnOpenClick" />
                </StackPanel>
            </Grid>

            <TextBlock
                Style="{StaticResource HintTextStyle}"
                Text="也可以直接把 .pwdb 和 .key 文件拖到窗口里：先拖密码库，再拖钥匙。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
