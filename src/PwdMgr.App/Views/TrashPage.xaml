<Page
    x:Class="PwdMgr.App.Views.TrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PwdMgr.App.ViewModels"
    Background="Transparent">

    <Grid Padding="28,20,28,18" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Content="返回" Click="OnBackClick" MinWidth="88" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="回收站" FontSize="22" FontWeight="SemiBold" />
                <TextBlock
                    Text="删除的条目在这里保留 30 天，超过后自动清除。"
                    Style="{StaticResource HintTextStyle}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                x:Name="EmptyTrashButton"
                Content="清空回收站"
                Click="OnEmptyTrashClick"
                IsEnabled="False" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            x:Name="ErrorBar"
            Severity="Error"
            IsOpen="False"
            IsClosable="True" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <ListView
                    x:Name="TrashList"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrashItemView">
                            <StackPanel Padding="4,8" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Username}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind DeletedText}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xE74D;"
                        FontSize="26"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="回收站是空的"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="StatusText" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="RestoreButton"
                    AutomationProperties.AutomationId="RestoreButton"
                    Content="恢复"
                    IsEnabled="False"
                    Click="OnRestoreClick" />
                <Button
                    x:Name="PurgeButton"
                    AutomationProperties.AutomationId="PurgeButton"
                    Content="彻底删除"
                    IsEnabled="False"
                    Click="OnPurgeClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
