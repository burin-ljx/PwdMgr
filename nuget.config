<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 依赖统一还原到仓库内的 .artifacts/nuget，避免写入用户级 NuGet 目录。 -->
  <config>
    <add key="globalPackagesFolder" value=".artifacts\nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
