<Page
    x:Class="PwdMgr.App.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PwdMgr.Core.Models"
    Background="Transparent">

    <Grid Padding="28,20,28,18" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock x:Name="VaultNameText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="VaultMetaText" Style="{StaticResource HintTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Click="OnLockClick" MinWidth="88" ToolTipService.ToolTip="锁定后需要重新选择钥匙文件">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" />
                    <TextBlock Text="上锁" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="SearchBox"
                PlaceholderText="搜索标题、用户名、网址、备注"
                Height="34"
                Width="380"
                HorizontalAlignment="Left"
                TextChanged="OnSearchChanged" />
            <Button Grid.Column="1" Content="新建条目" IsEnabled="False" ToolTipService.ToolTip="下一阶段开放" />
            <Button Grid.Column="2" Content="生成器" IsEnabled="False" ToolTipService.ToolTip="下一阶段开放" />
        </Grid>

        <!-- 列表 + 详情 -->
        <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="16">

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                    <ListView
                        x:Name="ItemList"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PasswordItem">
                                <StackPanel Padding="4,8" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Username}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyListPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="26"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="还没有条目"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <!-- 详情：字段直接可编辑，改动后底部出现保存操作 -->
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                                <InfoBar
                                    x:Name="SaveErrorBar"
                                    Severity="Error"
                                    IsOpen="False"
                                    IsClosable="True" />

                                <TextBox
                                    x:Name="EditTitle"
                                    AutomationProperties.AutomationId="TitleBox"
                                    PlaceholderText="标题（必填）"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextChanged="OnFieldChanged" />

                                <TextBlock x:Name="DetailCreated" Style="{StaticResource HintTextStyle}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="用户名" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditUsername"
                                        AutomationProperties.AutomationId="UsernameBox"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <PasswordBox
                                            x:Name="EditPassword"
                                            AutomationProperties.AutomationId="PasswordBox"
                                            PasswordChanged="OnPasswordChanged" />
                                        <ToggleButton
                                            x:Name="RevealButton"
                                            Grid.Column="1"
                                            Width="36"
                                            Height="30"
                                            Padding="0"
                                            Click="OnToggleRevealClick"
                                            ToolTipService.ToolTip="显示 / 隐藏密码">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="网址" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditUrl"
                                        AutomationProperties.AutomationId="UrlBox"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="标签" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditTags"
                                        AutomationProperties.AutomationId="TagsBox"
                                        PlaceholderText="用逗号分隔，例如：工作, 开发"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox
                                        x:Name="EditNotes"
                                        AutomationProperties.AutomationId="NotesBox"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="72"
                                        TextChanged="OnFieldChanged" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border
                            x:Name="SaveBar"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="0,12,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SaveButton"
                                    AutomationProperties.AutomationId="SaveButton"
                                    Content="保存修改"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnSaveClick" />
                                <Button Content="放弃修改" Click="OnRevertClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        x:Name="NoSelectionPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="从左侧选择一个条目"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource HintTextStyle}" />
    </Grid>
</Page>
